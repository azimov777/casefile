# Пример окружения. Скопировать в .env и поправить под себя:
#   cp .env.example .env
#
# Файл лежит рядом с compose-файлами и работает одинаково в обоих контурах — и в
# разработке, и в продакшене. Читают его двое: docker compose (подстановка ${...} в
# сами compose-файлы) и приложение в контейнере, которому compose передаёт файл целиком
# (`env_file:` у сервисов приложения). Внутрь образа файл не копируется
# (`.dockerignore`) — секреты остаются на машине владельца установки.
#
# Что здесь править бесполезно, сказано ниже у самих строк: переменные, которые контур
# задаёт сервису сам (`x-app-environment`), приезжают настоящим окружением, а оно в
# Compose приоритетнее `env_file`.
#
# Что в итоге доедет до приложения, видно до запуска — команда печатает окружение
# каждого сервиса целиком:
#   docker compose config                                # разработка
#   docker compose -f docker-compose.prod.yml config     # продакшен

# --- Переменные самого compose (приложение их не читает) ---
# Реквизиты сервиса db: с ними поднимается контейнер PostgreSQL, и из них же контур
# собирает адрес базы для приложения — разъехаться они поэтому не могут. В прод-контуре
# база наружу не публикуется, поэтому умолчания годятся и там.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_PORT=5432
# Порт, на котором API дев-контура виден с хост-машины. Внутри контейнера uvicorn всегда
# слушает 0.0.0.0:8000 — это задано командой сервиса api, — а здесь только левая половина
# проброса. В настройках приложения такого поля нет: читать порт неоткуда и незачем.
TRACKER_PORT=8000

# --- Установка Casefile (docker-compose.prod.yml) ---
# Порт, где открывается интерфейс; REST виден там же, через прокси /api.
CASEFILE_PORT=8080
# Адрес, на котором публикуются порты интерфейса и MCP. 127.0.0.1 — только эта машина.
# 0.0.0.0 — вся сеть, и тогда обязателен пароль владельца (TRACKER_PASSWORD_HASH ниже):
# без него интерфейс не поднимется, иначе он раздавал бы ключ установки любому в сети.
# По голому HTTP пароль и ключ видны всякому на пути — дальше доверенной сети только
# за обратным прокси с TLS (README, «Network mode»).
CASEFILE_BIND=127.0.0.1
# Прокси перед установкой (Caddy, nginx с TLS), которым интерфейс верит заголовок
# X-Forwarded-For: адреса и сети через запятую — тот адрес, с которого интерфейс видит
# прокси (первое поле строк `docker compose logs ui`). Пусто — никому: клиент это тот,
# кто открыл соединение. За прокси без этой строки все клиенты видны адресом прокси, и
# окно неудачных попыток входа по паролю у них одно на всех (README, «Network mode»).
CASEFILE_TRUSTED_PROXIES=
# Откуда брать образы и какой выпуск: <реестр>/casefile и <реестр>/casefile-ui с этим
# тегом. `latest` — последний коммит main.
CASEFILE_REGISTRY=ghcr.io/azimov777
CASEFILE_VERSION=latest
# Служба updater при каждом старте Docker тянет свежие образы и пересоздаёт службы.
# false — выключить; обновиться тогда можно повторным запуском установщика.
CASEFILE_AUTO_UPDATE=true
# Проверять обновления ещё и на ходу, раз в столько часов. 0 — только при старте Docker:
# пересоздание mcp посреди работы рвёт сессию MCP у подключённого агента.
CASEFILE_UPDATE_INTERVAL=0
# Откуда updater освежает сам compose-файл перед обновлением. Установщик ставит сюда адрес
# файла в main; пусто — файл не трогается (так и надо в клоне репозитория).
CASEFILE_COMPOSE_URL=

# --- Задаёт контур, а не этот файл ---
# Строки ниже перечислены, чтобы список настроек приложения был полным, но правка
# их здесь ничего не меняет: контур задаёт эти переменные сервису сам и побеждает файл.
# Режим и подробность логов — свойство контура (в разработке local и true, в проде
# production и false), а адрес базы собирается из POSTGRES_* выше. Менять — в
# соответствующем compose-файле, блок `x-app-environment`.
TRACKER_ENVIRONMENT=local          # local | test | production
TRACKER_DEBUG=true
# Хост db — имя сервиса в сети compose; с хост-машины база видна как localhost.
TRACKER_DATABASE_URL=postgresql+asyncpg://tracker:tracker@db:5432/tracker
# Кому API верит адрес клиента в X-Real-IP (для окна попыток входа по паролю): адреса,
# сети или имена хостов через запятую. Установка называет службу `ui` — свой nginx, дев-
# контур никого: API там опубликован напрямую, и заголовок пишет сам клиент.
TRACKER_REAL_IP_FROM=

# --- Приложение ---
# Источники, которым разрешён браузерный фронтенд. Единственная переменная приложения,
# которую контур подставляет в своё окружение прямо отсюда: правка здесь действует в
# обоих контурах. Интерфейсу установки она не нужна — он ходит в API через свой же
# источник, — а нужна фронтенду, запущенному отдельно.
TRACKER_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Тестовая база. Если не задать — берётся основная с суффиксом _test. Нужна только
# дев-контуру: тесты идут командой docker compose run --rm test.
TRACKER_TEST_DATABASE_URL=postgresql+asyncpg://tracker:tracker@db:5432/tracker_test

# --- Вход владельца по паролю ---
# Хеш пароля, которым закрыта установка, выставленная в сеть. Сам пароль нигде не
# хранится; строку для этого файла печатает команда (спросит пароль дважды, без эха):
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api python -m app.cli password-hash
# Пусто — пароля нет: интерфейс отдаёт ключ без входа, как на локальной установке.
# Сменить пароль — вписать новый хеш и `docker compose up -d`: все сеансы кончатся.
TRACKER_PASSWORD_HASH=
# Сколько часов живёт сеанс браузера после входа по паролю. Сеансы живут в памяти
# процесса API: выход и перезапуск API кончают их раньше срока.
TRACKER_SESSION_HOURS=168

# --- Лента журнала ---
# Потолок долгого ожидания (60 секунд) — часть контракта, а не настройка: он объявлен
# в схеме параметра `wait` и приезжает в подробностях отказа. Здесь только то, что
# зависит от установки.
#
# Контрольный опрос. Ожидание и поток будит PostgreSQL через LISTEN/NOTIFY; это
# страховка на случай, когда соединение слушателя оборвалось, — тогда лента отдаёт
# записи с задержкой не больше этого значения вместо того, чтобы молчать.
# Через него же меряется реакция на ушедшего клиента: оборванный долгий опрос
# прекращается не позже следующей проверки.
TRACKER_JOURNAL_WAIT_POLL_INTERVAL=5
# Тик простаивающего потока SSE: не даёт прокси закрыть соединение и позволяет заметить
# ушедшего клиента.
TRACKER_JOURNAL_STREAM_HEARTBEAT_INTERVAL=15
# Сколько потоков SSE один процесс обслуживает одновременно. Сверху ограничено пулом
# соединений к БД: каждый поток берёт соединение на время чтения хвоста.
TRACKER_JOURNAL_STREAM_MAX_CONNECTIONS=50

# --- MCP-сервер для агентов ---
# Порт, который публикуется наружу: к нему подключается клиент MCP (Claude Code и
# подобные). В отличие от TRACKER_PORT его читают оба — и compose для проброса, и сам
# процесс MCP, который поднимает сервер сам; поэтому в compose он стоит по обе стороны
# проброса и двигает порт сразу снаружи и внутри. Адрес внутри контейнера — 0.0.0.0,
# менять его незачем.
TRACKER_MCP_PORT=8100
TRACKER_MCP_HOST=0.0.0.0
# Путь эндпоинта streamable HTTP. Полный адрес подключения — http://<хост>:8100/mcp
TRACKER_MCP_PATH=/mcp
# Адрес MCP снаружи — тот, что клиент агента (Claude Code, Codex) кладёт в свою
# конфигурацию. Его API сообщает интерфейсу (`GET /api/v1/installation`), и из него
# интерфейс собирает готовые фрагменты подключения. TRACKER_MCP_HOST, _PORT и _PATH
# выше — привязка процесса внутри контейнера, а это адрес для клиента, и совпадают они
# только на этой машине.
# Пусто — http://localhost:<TRACKER_MCP_PORT><TRACKER_MCP_PATH>: верно для клиента на
# машине установки и двигается вместе с портом. Задавать целиком, со схемой и путём, когда
# MCP видят иначе: через прокси, по TLS, с другой машины, например
# https://casefile.example.com/mcp. Пароль в адресе не принимается: адрес видит всякий
# держатель ключа. По заголовкам запроса адрес не угадывается: запрос пришёл в интерфейс.
TRACKER_MCP_PUBLIC_URL=
# Размер страницы у инструментов, которые её отдают (`read_entries`, `search_tasks`,
# `wait_journal`, `list_participants`). Меньше, чем у REST: страницу человека листают,
# страницу инструмента агент кладёт в контекст и платит за неё токенами.
TRACKER_MCP_PAGE_SIZE=25
# Потолок длинного текста в выдаче `search_tasks` (описание задачи, её разделы). Обрезка
# всегда объявлена рядом со значением, а задача целиком — один вызов `get_task`. Тела
# записей дела не обрезаются: их запрашивают по номеру, и брать их больше неоткуда.
TRACKER_MCP_TEXT_LIMIT=2000

# --- Диагностика ---
TRACKER_DATABASE_ECHO=false        # true — печатать SQL в лог

# Пул соединений с базой на один процесс: размер пула и сколько соединений можно
# открыть сверх него под пиковую нагрузку. Значения по умолчанию совпадают с кодом.
TRACKER_DATABASE_POOL_SIZE=5
TRACKER_DATABASE_MAX_OVERFLOW=10
