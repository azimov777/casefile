# Пример окружения. Скопировать в .env и поправить под себя:
#   cp .env.example .env
#
# Файл читают оба: docker compose (подстановка в compose-файлы) и само приложение
# (pydantic-settings). Переменные окружения приоритетнее значений из файла.

# --- PostgreSQL: реквизиты сервиса db ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_PORT=5432

# --- Приложение ---
TRACKER_ENVIRONMENT=local          # local | test | production
TRACKER_DEBUG=true
TRACKER_PORT=8000
TRACKER_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Адреса БД. Хост db — имя сервиса в сети compose; с хост-машины база видна как localhost.
TRACKER_DATABASE_URL=postgresql+asyncpg://tracker:tracker@db:5432/tracker
# Тестовая база. Если не задать — берётся основная с суффиксом _test.
TRACKER_TEST_DATABASE_URL=postgresql+asyncpg://tracker:tracker@db:5432/tracker_test

# --- Воркер шины событий ---
# Пауза, когда очередь событий пуста.
TRACKER_OUTBOX_POLL_INTERVAL=1.0
# Сколько раз пытаться доставить событие, прежде чем пометить его недоставленным.
TRACKER_OUTBOX_MAX_ATTEMPTS=5
# Пауза перед следующей попыткой; удваивается с каждой и упирается в потолок.
TRACKER_OUTBOX_RETRY_DELAY=10.0
TRACKER_OUTBOX_MAX_RETRY_DELAY=600.0

# --- Движок автоматики ---
# Как глубоко может уходить цепочка «правило → изменение → событие → правило».
# 0 полностью запрещает правилам реагировать на изменения других правил.
TRACKER_AUTOMATION_MAX_CHAIN_DEPTH=3
# Сколько раз одно правило может сработать по одной задаче внутри окна. Это защита от
# волны: завершение спринта на двести задач даёт двести законных событий подряд.
TRACKER_AUTOMATION_RATE_LIMIT=10
TRACKER_AUTOMATION_RATE_WINDOW=60.0
# Как часто планировщик смотрит, не пора ли какому-нибудь автодействию.
TRACKER_AUTOMATION_TICK_INTERVAL=30.0
# Сколько задач одно автодействие обрабатывает за тик; остальные ждут следующего.
TRACKER_AUTOMATION_BATCH_SIZE=200

# --- Уведомления ---
# Окно склейки повторов: событие того же типа по тому же объекту, пришедшее в течение
# этого времени, дописывается в непрочитанную запись счётчиком, а не заводит новую.
# 0 отключает склейку — десять правок задачи за минуту дадут десять записей.
TRACKER_NOTIFICATION_DIGEST_WINDOW=60.0
# Сколько ждёт `GET /notifications/wait`, если клиент не назвал таймаут сам, и потолок
# того, что он может попросить: запрос сверх потолка отвергается, а не срезается молча.
TRACKER_NOTIFICATION_WAIT_TIMEOUT=25.0
TRACKER_NOTIFICATION_WAIT_MAX_TIMEOUT=60.0
# Контрольный опрос во время ожидания. Основной канал — оповещение PostgreSQL, это
# страховка на случай, если соединение слушателя оборвалось.
TRACKER_NOTIFICATION_WAIT_POLL_INTERVAL=2.0

# --- Вебхуки ---
# Таймаут одной попытки доставки. Короткий намеренно: строка задания заблокирована всё
# время запроса, и мёртвый адрес держит открытую транзакцию ровно столько.
TRACKER_WEBHOOK_TIMEOUT=10.0
# Сколько раз пытаться доставить ОДНУ доставку по ОДНОМУ адресу. Это не то же самое, что
# TRACKER_OUTBOX_MAX_ATTEMPTS: та настройка повторяет событие по упавшим подписчикам.
TRACKER_WEBHOOK_MAX_ATTEMPTS=5
# Пауза перед следующей попыткой; удваивается с каждой и упирается в потолок.
TRACKER_WEBHOOK_RETRY_DELAY=10.0
TRACKER_WEBHOOK_MAX_RETRY_DELAY=600.0
# Пауза, когда очередь доставок пуста.
TRACKER_WEBHOOK_POLL_INTERVAL=1.0
# Сколько неудачных ПОПЫТОК подряд гасит подписку. Любая успешная доставка обнуляет
# счётчик: получатель, теряющий каждую вторую доставку, работает, и гасить его нельзя.
# Включают подписку обратно вручную — включение обнуляет счётчик.
TRACKER_WEBHOOK_FAILURE_THRESHOLD=10

# --- Стрим событий (SSE) ---
# Как часто в поток уходит служебный тик. Он не даёт прокси закрыть простаивающее
# соединение и позволяет серверу заметить ушедшего клиента.
TRACKER_STREAM_HEARTBEAT_INTERVAL=15.0
# Сколько потоков одновременно обслуживает ОДИН процесс API. Каждый ходит в базу на
# каждой проверке, поэтому потолок упирается в размер пула соединений.
TRACKER_STREAM_MAX_CONNECTIONS=50
# Сколько событий отдаётся при переподключении по Last-Event-ID. Клиент, отставший
# больше, получает отказ с просьбой перечитать состояние через API, а не молчаливый
# старт «с текущего момента»: тихий пропуск означал бы рассинхронизацию, о которой он
# не узнает.
TRACKER_STREAM_REPLAY_LIMIT=500
# Контрольный опрос очереди событий во время ожидания. Основной канал — оповещение
# PostgreSQL, это страховка на случай оборванного соединения слушателя.
TRACKER_STREAM_POLL_INTERVAL=5.0

# --- MCP-сервер для агентов ---
# Порт, который публикуется наружу: к нему подключается клиент MCP (Claude Code и
# подобные). Адрес внутри контейнера — 0.0.0.0, менять его незачем.
TRACKER_MCP_PORT=8100
TRACKER_MCP_HOST=0.0.0.0
# Путь эндпоинта streamable HTTP. Полный адрес подключения — http://<хост>:8100/mcp
TRACKER_MCP_PATH=/mcp
# Размер страницы у инструментов MCP. Меньше, чем у REST, намеренно: каждая строка
# выдачи съедает контекст агента, а дочитать он может по курсору.
TRACKER_MCP_PAGE_SIZE=25
# До скольких символов обрезается длинный текст (описание задачи, тело комментария) в
# ответе инструмента. Обрезка не молчаливая: рядом приезжает признак и полная длина.
TRACKER_MCP_TEXT_LIMIT=2000

# --- Диагностика ---
TRACKER_DATABASE_ECHO=false        # true — печатать SQL в лог
