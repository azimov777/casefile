# Пример окружения. Скопировать в .env и поправить под себя:
#   cp .env.example .env
#
# Файл читают оба: docker compose (подстановка в compose-файлы) и само приложение
# (pydantic-settings). Переменные окружения приоритетнее значений из файла.

# --- PostgreSQL: реквизиты сервиса db ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_PORT=5432

# --- Приложение ---
TRACKER_ENVIRONMENT=local          # local | test | production
TRACKER_DEBUG=true
TRACKER_PORT=8000
TRACKER_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Адреса БД. Хост db — имя сервиса в сети compose; с хост-машины база видна как localhost.
TRACKER_DATABASE_URL=postgresql+asyncpg://tracker:tracker@db:5432/tracker
# Тестовая база. Если не задать — берётся основная с суффиксом _test.
TRACKER_TEST_DATABASE_URL=postgresql+asyncpg://tracker:tracker@db:5432/tracker_test

# --- Диагностика ---
TRACKER_DATABASE_ECHO=false        # true — печатать SQL в лог
