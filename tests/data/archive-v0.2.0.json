    ["49", "72ad5c8d-3078-4f8d-8af4-fb0716d4edb2", "20", "remark", "В отказе не видно, какой именно номер не был выдан", "Пока никто не разбирал: это второе замечание и оно ждёт своей резолюции.", "{}", "[]", "human", "owner", "085210cb-534b-4d92-9012-5d04763b7017", "2026-10-07 10:44:01.260306+00", "2026-10-07 10:44:01.260306+00", "775010b0-687a-4217-abbc-b5dedfef7816"],
