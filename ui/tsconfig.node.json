{
  "compilerOptions": {
    "target": "ES2022",
    // DOM нужен не оснастке, а коду внутри `page.evaluate`: он выполняется в браузере.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "steiger.config.ts"]
}
