# Настройки постоянного контура интерфейса (`docker-compose.prod.yml`) и команды подъёма
# (`scripts/up.sh`).
#
# Скопируйте рядом под именем `.env` и поправьте под свою машину:
#
#   cp .env.example .env
#
# Файл читают compose и скрипт подъёма — оба на хосте; внутрь образа он не попадает
# (`.dockerignore`). В репозиторий `.env` не коммитится (см. `.gitignore`): сегодня в нём
# имя сети, завтра окажется токен.
#
# Значения пишутся без кавычек и без пробелов вокруг `=`: это не сценарий оболочки.

# Сеть бэкенда, к которой интерфейс подключается гостем. Своей сети он не поднимает,
# поэтому имя обязано указывать на **уже работающий** контур бэкенда.
#
# Имя складывается из имени проекта compose и имени сети по умолчанию:
# прод-контур бэкенда даёт `tracker-prod_default`, дев-контур — `tracker_default`.
# Узнать имя работающего контура:
#
#   docker network ls --format '{{.Name}}' | grep tracker
#
# Умолчания у этой переменной нет намеренно: правильное значение зависит от того, какой
# контур бэкенда поднят на машине, и угадать его файл в репозитории не может.
TRACKER_NETWORK=tracker-prod_default

# Куда nginx проксирует `/api` внутри этой сети. Менять нужно, только если сервис
# бэкенда назван не `api`: у дев- и прод-контуров он называется одинаково.
#TRACKER_API_URL=http://api:8000

# Порт постоянного контура. Умолчание 8080.
#
# Публикуется он только на петлю (`127.0.0.1`), и это часть замысла, а не осторожность:
# с ключом от установки этот порт раздаёт рабочий ключ набора `task` всякому, кто его
# открыл. Кому нужен интерфейс для нескольких людей, тот поднимает контур без ключа и
# публикует порт сам — README, «Интерфейс для нескольких людей».
#UI_PORT=8080

# `UI_PORT` здесь задаёт порт **обоим** контурам: тот же `.env` читает и
# `docker-compose.yml` сквозных тестов. Разводить их этим файлом не надо — у них разные
# умолчания (8080 постоянному, 8081 сквозным), и в этом весь смысл.


# Дальше — то, что нужно команде подъёма `./scripts/up.sh` (она же `pnpm start`). Она
# поднимает установку целиком: бэкенд, миграции, владельца, ключ интерфейса, интерфейс.
# Три переменные ниже говорят ей, где бэкенд и каким контуром он поднят.

# Каталог репозитория бэкенда. Путь считается от корня этого репозитория.
#TRACKER_BACKEND_DIR=..

# Каким контуром поднимать бэкенд. Значение обязано согласоваться с `TRACKER_NETWORK`
# выше: имя сети складывается из имени проекта того же файла. `docker-compose.prod.yml`
# даёт `tracker-prod_default`, `docker-compose.yml` — `tracker_default`.
#TRACKER_BACKEND_COMPOSE=docker-compose.prod.yml

# Файл, в который установка кладёт ключ своего интерфейса. Его пишет команда
# `local-token` бэкенда, и путь у обоих его контуров одинаковый.
#
# Здесь назван **путь**, а не сам ключ: секрету в этом файле делать нечего. Скрипт
# подъёма читает файл на хосте и передаёт значение контуру переменной `TRACKER_UI_TOKEN`,
# а шаг старта образа (`docker/config-json.sh`) кладёт его рядом со статикой как
# `/config.json`. Нет файла — нет конфигурации, и интерфейс встречает экраном входа.
#TRACKER_UI_TOKEN_FILE=../.secrets/ui-token
