# Настройки постоянного контура интерфейса (`docker-compose.prod.yml`).
#
# Скопируйте рядом под именем `.env` и поправьте под свою машину:
#
#   cp .env.example .env
#
# Файл читает compose на хосте, внутрь образа он не попадает. В репозиторий `.env` не
# коммитится (см. `.gitignore`): сегодня в нём имя сети, завтра окажется токен.

# Сеть бэкенда, к которой интерфейс подключается гостем. Своей сети он не поднимает,
# поэтому имя обязано указывать на **уже работающий** контур бэкенда.
#
# Имя складывается из имени проекта compose и имени сети по умолчанию:
# прод-контур бэкенда даёт `tracker-prod_default`, дев-контур — `tracker_default`.
# Узнать имя работающего контура:
#
#   docker network ls --format '{{.Name}}' | grep tracker
#
# Умолчания у этой переменной нет намеренно: правильное значение зависит от того, какой
# контур бэкенда поднят на машине, и угадать его файл в репозитории не может.
TRACKER_NETWORK=tracker-prod_default

# Куда nginx проксирует `/api` внутри этой сети. Менять нужно, только если сервис
# бэкенда назван не `api`: у дев- и прод-контуров он называется одинаково.
#TRACKER_API_URL=http://api:8000

# Порт постоянного контура наружу. Умолчание 8080.
#UI_PORT=8080

# `UI_PORT` здесь задаёт порт **обоим** контурам: тот же `.env` читает и
# `docker-compose.yml` сквозных тестов. Разводить их этим файлом не надо — у них разные
# умолчания (8080 постоянному, 8081 сквозным), и в этом весь смысл.
