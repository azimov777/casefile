# Схема, по которой пришёл браузер. За обратным прокси с TLS nginx видит голый HTTP, и
# своя `$scheme` сказала бы API «http» — кука сеанса осталась бы без `Secure`. Прокси
# сообщает правду заголовком `X-Forwarded-Proto`; нет заголовка — прокси нет, и схема
# своя. Верить заголовку клиента здесь можно: подделав его, клиент лишь сделает свою же
# куку строже (`app/api/routes/session.py`, `_arrived_over_https`).
map $http_x_forwarded_proto $casefile_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name localhost 127.0.0.1 [::1];

    root /usr/share/nginx/html;
    index index.html;

    # Режим доступа пишет при старте `docker/access-mode.sh` двумя файлами: этот —
    # правило `Host` для всего сервера, второй — условие выдачи `/config.json` ниже.
    #
    # Без пароля — защита от DNS rebinding (UI-107): отвечать только адресам петли.
    # Один server-блок на весь файл сам по себе обслужил бы любой Host, потому что nginx
    # выбирает умолчание по listen, а не по server_name, когда сравнивать не с чем; отказ
    # `421` даёт именно правило из файла. Порт опубликован только на петле, но это не
    # защита от вкладки браузера: страница чужого домена, перепривязавшего DNS-запись на
    # этот адрес, открывает соединение так же свободно, как «своя», — источник браузер
    # сверяет с адресной строкой, а не с тем, куда фактически пришёл TCP. Заголовок Host
    # — единственное отличие такого запроса от настоящего, и только по нему можно
    # отказать. Список — адреса петли (`localhost`, `127.0.0.1`, `[::1]`; порт `$host`
    # уже не несёт).
    #
    # С паролем владельца правила нет (TRK-90#7): сервер отвечает любому своему имени и за
    # любым прокси, а ключ страница чужого домена не получит и так — куки сеанса этого
    # источника у неё нет, и `/config.json` ей не отдаётся.
    include /etc/nginx/casefile/host-guard.conf;

    # Кто клиент (TRK-98#6). По умолчанию — тот, кто открыл соединение (`$remote_addr`).
    # Если соединение пришло от прокси, которого владелец назвал доверенным
    # (`TRACKER_UI_TRUSTED_PROXIES`), модуль realip заменяет `$remote_addr` самым правым
    # адресом `X-Forwarded-For`, не названным доверенным. Список пуст — `X-Forwarded-For`
    # не значит ничего: написать его может кто угодно. Файл пишет `docker/access-mode.sh`.
    # Итог уходит в API заголовком `X-Real-IP` (`location /api/` ниже), а API считает по
    # нему попытки входа на адрес клиента.
    include /etc/nginx/casefile/real-ip.conf;

    # Конфигурация установки: её кладёт при старте `docker/config-json.sh`, если контуру
    # дали ключ. Свой `location` заведён ради честного `404`: под общим правилом ниже
    # запрос к несуществующему файлу получил бы `200` и разметку index.html, и «ключа
    # нет» отличалось бы от «ключ есть» только тем, разбирается ли тело.
    #
    # С паролем владельца файл отдаётся только живому сеансу: `auth_request` спрашивает
    # API (`/_casefile/session` ниже), а отказ приходит `401 {"login":"password"}`
    # (`@login_required`). Без пароля условия нет. Условие пишет `docker/access-mode.sh`.
    #
    # `no-store` — чтобы ключ приезжал заново на каждой загрузке вкладки: контур вправе
    # перевыпустить его, а ответ из кэша вернул бы только что отказавший.
    location = /config.json {
        include /etc/nginx/casefile/config-guard.conf;
        try_files $uri =404;
        add_header Cache-Control 'no-store' always;
    }

    # Подзапрос `auth_request`: жив ли сеанс из куки (`GET /api/v1/session`). Снаружи не
    # виден (`internal`). Метод назван явно: подзапрос наследует метод исходного, и
    # `HEAD /config.json` иначе ушёл бы в API маршрутом, которого там нет. Тело не нужно —
    # API решает по куке, а она едет в заголовках исходного запроса.
    location = /_casefile/session {
        internal;
        proxy_pass ${TRACKER_API_URL}/api/v1/session;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $casefile_forwarded_proto;
    }

    # Ответ «ключ — после входа по паролю». Тело — контракт с интерфейсом
    # (`src/shared/api/install-config.ts`): по нему он рисует форму пароля, а не поле
    # токена. Без тела `401` значил бы для него то же, что «ключа нет».
    location @login_required {
        default_type application/json;
        add_header Cache-Control 'no-store' always;
        return 401 '{"login":"password"}';
    }

    # Одностраничное приложение: любой путь, кроме файла, отдаёт index.html —
    # иначе перезагрузка на /tasks вернула бы 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API проксируется на свой источник намеренно: так токен едет только заголовком,
    # браузеру не нужен CORS, а адрес бэкенда не попадает в собранную статику.
    #
    # Адрес задаётся переменной окружения при запуске, а не при сборке: один и тот же
    # образ поднимается и рядом с контуром сквозных тестов (`api`), и рядом с прод-
    # контуром бэкенда. Шаблон разворачивает штатный скрипт образа nginx, а фильтр
    # `NGINX_ENVSUBST_FILTER` не даёт ему тронуть переменные самого nginx ($uri, $host).
    location /api/ {
        proxy_pass ${TRACKER_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Адрес клиента для окна попыток входа — один, и пишет его этот nginx, а не
        # клиент: `proxy_set_header` заменяет присланный заголовок, а не дописывает к нему.
        # API верит ему только от этой службы (`TRACKER_REAL_IP_FROM: ui`). Цепочку
        # `X-Forwarded-For` API не читает; она идёт дальше как есть, для журналов.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $casefile_forwarded_proto;

        # Живой поток журнала (задача 07) — SSE: буферизация и таймаут его бы порвали.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
