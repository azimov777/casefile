server {
    listen 80;
    server_name localhost 127.0.0.1 [::1];

    root /usr/share/nginx/html;
    index index.html;

    # Защита от DNS rebinding (UI-107). Один server-блок на весь файл — сам по себе
    # он обслужил бы любой Host, потому что nginx выбирает умолчание по listen, а не
    # по server_name, когда сравнивать не с чем; отказ даёт именно правило ниже.
    #
    # Порт опубликован только на петле, но это не защита от вкладки браузера: страница
    # чужого домена, перепривязавшего DNS-запись на этот адрес, открывает соединение
    # так же свободно, как «своя» страница — источник браузер сверяет с адресной строкой,
    # а не с тем, куда фактически пришёл TCP. Заголовок Host — единственное отличие такого
    # запроса от настоящего, и только по нему можно отказать.
    #
    # Список — адреса петли, на которых человек вообще может открыть эту установку
    # (`localhost`, `127.0.0.1`, `[::1]`; порт `$host` уже не несёт). Настраиваемый список
    # доменов сюда не входит: серверное развёртывание получит свой вход отдельной задачей.
    if ($host !~* '^(localhost|127\.0\.0\.1|\[?::1\]?)$') {
        return 421;
    }

    # Конфигурация установки: её кладёт при старте `docker/config-json.sh`, если контуру
    # дали ключ. Свой `location` заведён ради честного `404`: под общим правилом ниже
    # запрос к несуществующему файлу получил бы `200` и разметку index.html, и «ключа
    # нет» отличалось бы от «ключ есть» только тем, разбирается ли тело.
    #
    # `no-store` — чтобы ключ приезжал заново на каждой загрузке вкладки: контур вправе
    # перевыпустить его, а ответ из кэша вернул бы только что отказавший.
    location = /config.json {
        try_files $uri =404;
        add_header Cache-Control 'no-store' always;
    }

    # Одностраничное приложение: любой путь, кроме файла, отдаёт index.html —
    # иначе перезагрузка на /tasks вернула бы 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API проксируется на свой источник намеренно: так токен едет только заголовком,
    # браузеру не нужен CORS, а адрес бэкенда не попадает в собранную статику.
    #
    # Адрес задаётся переменной окружения при запуске, а не при сборке: один и тот же
    # образ поднимается и рядом с контуром сквозных тестов (`api`), и рядом с прод-
    # контуром бэкенда. Шаблон разворачивает штатный скрипт образа nginx, а фильтр
    # `NGINX_ENVSUBST_FILTER` не даёт ему тронуть переменные самого nginx ($uri, $host).
    location /api/ {
        proxy_pass ${TRACKER_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Живой поток журнала (задача 07) — SSE: буферизация и таймаут его бы порвали.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
