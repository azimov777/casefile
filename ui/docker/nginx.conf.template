server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Одностраничное приложение: любой путь, кроме файла, отдаёт index.html —
    # иначе перезагрузка на /tasks вернула бы 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API проксируется на свой источник намеренно: так токен едет только заголовком,
    # браузеру не нужен CORS, а адрес бэкенда не попадает в собранную статику.
    #
    # Адрес задаётся переменной окружения при запуске, а не при сборке: один и тот же
    # образ поднимается и рядом с контуром сквозных тестов (`api`), и рядом с прод-
    # контуром бэкенда. Шаблон разворачивает штатный скрипт образа nginx, а фильтр
    # `NGINX_ENVSUBST_FILTER` не даёт ему тронуть переменные самого nginx ($uri, $host).
    location /api/ {
        proxy_pass ${TRACKER_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Живой поток журнала (задача 07) — SSE: буферизация и таймаут его бы порвали.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
