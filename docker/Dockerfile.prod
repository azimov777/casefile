# Продакшен-образ: многостадийная сборка. Компиляторы и заголовки остаются в
# стадии builder, в рантайм уезжает только готовое виртуальное окружение и код.

# uv — тот же, что в дев-образе, и отдельной стадией по той же причине: бот обновлений
# читает только строки FROM (`.github/dependabot.yml`).
FROM ghcr.io/astral-sh/uv:0.12.17 AS uv

FROM python:3.14-slim AS builder

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /src

# Ставятся только рантайм-зависимости (без extra `dev`) и строго из `uv.lock`: `--locked`
# валит сборку, если lock-файл разошёлся с `pyproject.toml`. Сам проект в окружение не
# ставится: в рантайм код приезжает файлами, а не колесом.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project


FROM python:3.14-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app

RUN useradd --create-home --uid 1000 tracker

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=tracker:tracker alembic.ini ./
COPY --chown=tracker:tracker app ./app
# Скил — не документация, а часть рантайма: MCP-сервер раздаёт его текст промптом
# `tracker-discipline` и берёт из него `instructions`. Без этой строки процесс MCP падает
# на старте, а не молча отдаёт пустую дисциплину (`app/mcp/skill.py`).
COPY --chown=tracker:tracker skill ./skill
# Файл установки того же выпуска, что и образ: установщик и служба `updater` берут его
# отсюда, а не с main на GitHub, — так файл и образы установки никогда не расходятся
# (`docker-compose.prod.yml`, служба `updater`). Процессу он не нужен.
COPY --chown=tracker:tracker docker-compose.prod.yml ./
# Точка монтирования томов с ключами (`docker-compose.prod.yml`, `ui-key` и `agent-key`).
# Каталог заводится здесь и отдаётся пользователю образа: пустой именованный том при
# первом монтировании берёт владельца и права у каталога образа, а каталог, которого в
# образе нет, Docker создаёт от root — и непривилегированный процесс не запишет туда
# ключ. `0700`: в каталоге лежат только секреты.
RUN install -d -o tracker -g tracker -m 0700 /app/.secrets

USER tracker

EXPOSE 8000

# Без --reload: в продакшене перезапуск по изменению файлов не нужен и опасен.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
